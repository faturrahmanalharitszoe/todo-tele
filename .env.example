BOT_TOKEN=123456789:isi_token_dari_BotFather

# Whitelist ID Telegram yang boleh pakai bot ini.
# Pisah pakai koma kalau lebih dari satu, contoh: 111111111,222222222
# Kosongin kalau semua orang boleh pakai.
ALLOWED_USER_IDS=123456789

# Dashboard web
# Password login dashboard (opsional). Kosongin kalau gak mau pakai auth.
DASHBOARD_PASSWORD=
# Host & port dashboard. Default cuma bisa diakses dari komputer sendiri.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

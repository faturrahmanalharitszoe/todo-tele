[Unit]
Description=Todo Telegram Dashboard (gunicorn)
After=network.target

[Service]
Type=simple
# Ganti sesuai user & lokasi project kamu
User=www-data
Group=www-data
WorkingDirectory=/opt/todo-tele
EnvironmentFile=/opt/todo-tele/.env

# Pastikan skema DB udah ter-migrate sebelum app jalan
ExecStartPre=/opt/todo-tele/.venv/bin/python -c "import db; db.init_db()"
ExecStart=/opt/todo-tele/.venv/bin/gunicorn -c /opt/todo-tele/deploy/gunicorn.conf.py dashboard:app

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
